# PostgreSQL (docker-compose 기본값). cp .env.example .env 로 복사해 사용한다
DATABASE_URL=postgresql+psycopg://stock:stock@localhost:5433/stockdb
TEST_DATABASE_URL=postgresql+psycopg://stock:stock@localhost:5433/stockdb_test

LOG_LEVEL=INFO

# 호스트 포트(기본값). 다른 서비스와 충돌하면 바꾼다
# DB_PORT=5433
# API_PORT=8000

# ── [S1-D] 시세 수집 ──
# 국내 시세 소스: pykrx | yfinance (pykrx가 막히면 yfinance로 바꿔 .KS/.KQ 심볼로 받는다)
PRICE_SOURCE_KR=pykrx
# pykrx 1.2.x는 시총·펀더멘털·지수 조회에 KRX 회원 로그인이 필요하다 (PRICE_SOURCE_KR=pykrx일 때만)
KRX_ID=
KRX_PW=

# 이후 단계에서 추가되는 항목(해당 단계 담당자가 이 파일에 구역을 추가한다)
#   Stage 2: DEFAULT_USER_ID   Stage 3: DART_API_KEY, SEC_USER_AGENT, REFRESH_TTL_HOURS, SCHEDULER_*
