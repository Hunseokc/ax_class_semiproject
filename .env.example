# PostgreSQL (docker-compose 기본값). cp .env.example .env 로 복사해 사용한다

# docker compose가 항상 개발용 덮어쓰기(compose.dev.yml: 소스 bind mount)를 함께 쓴다.
# 없으면 `docker compose run --rm api pytest`가 마지막 빌드 이미지의 옛 코드로 돌아 결과를 믿을 수 없다.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.yml:compose.dev.yml

DATABASE_URL=postgresql+psycopg://stock:stock@localhost:5433/stockdb
TEST_DATABASE_URL=postgresql+psycopg://stock:stock@localhost:5433/stockdb_test

LOG_LEVEL=INFO

# 호스트 포트(기본값). 다른 서비스와 충돌하면 바꾼다
# DB_PORT=5433
# API_PORT=8000

# ── [S1-D] 시세 수집 ──
# 국내 시세 소스: pykrx | yfinance (pykrx가 막히면 yfinance로 바꿔 .KS/.KQ 심볼로 받는다)
PRICE_SOURCE_KR=pykrx
# pykrx 1.2.x는 시총·펀더멘털·지수 조회에 KRX 회원 로그인이 필요하다 (PRICE_SOURCE_KR=pykrx일 때만)
KRX_ID=
KRX_PW=

# ── [S2-D] 사용자·갱신 TTL ──
# 1차는 로그인 없는 단일 사용자(데모) 모드: 모든 요청을 이 사용자로 처리한다 (로컬·시연 전용)
DEFAULT_USER_ID=1
# 배포(Cloud Run 등)에서 방문자를 브라우저별 게스트로 나눌 때만 true. 쿠키가 없을 때 조회는 DEFAULT_USER_ID 화면을 보여 주고,
# 첫 저장(관심종목 추가 등) 때 그 데이터를 복사한 게스트가 만들어진다. 쿠키는 HTTPS에서만 오가므로 로컬 http에서는 false로 둔다
GUEST_SESSION_ENABLED=false
# 세션 쿠키 서명 키 (GUEST_SESSION_ENABLED=true면 필수). 생성: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# 같은 종류 외부 호출 최소 간격(시간), 허용 3~4
REFRESH_TTL_HOURS=4

# ── [S3-D] 재무·공시 소스 ──
# OpenDART 인증키 (https://opendart.fss.or.kr 에서 발급)
DART_API_KEY=
# SEC EDGAR: 연락처(이메일)가 포함된 User-Agent 필수. 예) "stockmind-team your_name@example.com"
SEC_USER_AGENT=

# ── [S3-D] 스케줄러 ──
# 앱 안 스케줄러: 노출 종목 4시간(REFRESH_TTL_HOURS) 갱신, 매력도 비교군 매일 07:00(KST) 이후 1회 갱신
# 서버를 띄우지 않고 cron 등으로 돌릴 때는 false (python -m app.ingest refresh / benchmark)
SCHEDULER_ENABLED=true
SCHEDULER_CHECK_MINUTES=5

# 이후 단계에서 추가되는 항목(해당 단계 담당자가 이 파일에 구역을 추가한다)
