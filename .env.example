# PostgreSQL (docker-compose 기본값). cp .env.example .env 로 복사해 사용한다

# docker compose가 항상 개발용 덮어쓰기(compose.dev.yml: 소스 bind mount)를 함께 쓴다.
# 없으면 `docker compose run --rm api pytest`가 마지막 빌드 이미지의 옛 코드로 돌아 결과를 믿을 수 없다.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.yml:compose.dev.yml

DATABASE_URL=postgresql+psycopg://stock:stock@localhost:5433/stockdb
TEST_DATABASE_URL=postgresql+psycopg://stock:stock@localhost:5433/stockdb_test

LOG_LEVEL=INFO

# 호스트 포트(기본값). 다른 서비스와 충돌하면 바꾼다
# DB_PORT=5433
# API_PORT=8000

# ── [S1-D] 시세 수집 ──
# 국내 시세 소스: pykrx | yfinance (pykrx가 막히면 yfinance로 바꿔 .KS/.KQ 심볼로 받는다)
PRICE_SOURCE_KR=pykrx
# pykrx 1.2.x는 시총·펀더멘털·지수 조회에 KRX 회원 로그인이 필요하다 (PRICE_SOURCE_KR=pykrx일 때만)
KRX_ID=
KRX_PW=

# ── [S2-D] 사용자·갱신 TTL ──
# 1차는 로그인 없는 단일 사용자(데모) 모드: 모든 요청을 이 사용자로 처리한다 (로컬·시연 전용)
DEFAULT_USER_ID=1
# 같은 종류 외부 호출 최소 간격(시간), 허용 3~4
REFRESH_TTL_HOURS=4

# 이후 단계에서 추가되는 항목(해당 단계 담당자가 이 파일에 구역을 추가한다)
#   Stage 3: DART_API_KEY, SEC_USER_AGENT, SCHEDULER_*
